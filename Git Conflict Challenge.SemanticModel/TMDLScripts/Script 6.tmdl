createOrReplace

	ref table '_Global Measures'

		measure 'Dziennik Zakonu HTML' = ```
				VAR Wiersze = 
				    CONCATENATEX (
				        'Zakon Miary', 
				        "<div style='margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px dashed rgba(122, 74, 33, 0.35); text-align: left;'>
				            <span style='color: #8c2d19; font-weight: bold; font-size: 14px; margin-right: 8px; font-family: ""Georgia"", serif;'>" & 'Zakon Miary'[Inicjaly] & "</span>
				            <span style='color: #2c180b; font-style: italic; font-size: 13px; font-family: ""Georgia"", serif;'>" & 'Zakon Miary'[Komentarz] & "</span>
				        </div>", 
				        "", 
				        'Zakon Miary'[Kolejnosc], 
				        ASC
				    )
				RETURN
				    "<div style='
				        background: radial-gradient(ellipse at center, #f7ebcf 0%, #e6cf9c 70%, #d1b17a 100%);
				        border: 2px double #7a4a21; 
				        border-radius: 4px; 
				        padding: 10px 15px; 
				        font-family: ""Georgia"", serif; 
				        box-shadow: inset 0 0 20px rgba(90, 48, 15, 0.45), 2px 4px 8px rgba(0,0,0,0.2);
				        height: 100%; 
				        box-sizing: border-box;
				    '>
				        <h3 style='color: #5c2c12; text-align: center; text-transform: uppercase; letter-spacing: 2px; margin-top: 0; margin-bottom: 10px; border-bottom: 2px solid #8c2d19; padding-bottom: 6px; font-size: 16px; font-weight: bold;'>Ksiega Chwaly</h3>" & 
				        Wiersze & 
				    "</div>"
				```
			displayFolder: Zakon Miary
			lineageTag: a1b2c3d4-0000-1111-2222-333344445551
			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 'Szyfr Zakonu HTML' = ```
				VAR ZbudowanyTekst = 
				    CONCATENATEX(
				        'Zakon Miary', 
				        'Zakon Miary'[Fragment], 
				        " ", 
				        'Zakon Miary'[Kolejnosc], 
				        ASC
				    )
				RETURN
				"<div style='
				    text-align: center;
				    font-family: ""Georgia"", serif;
				    font-size: 14px; 
				    font-weight: bold;
				    color: #2c180b;
				    padding: 8px 10px; 
				    border-top: 2px solid #8c2d19;
				    border-bottom: 2px solid #8c2d19;
				    background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(209, 177, 122, 0.4) 50%, rgba(255,255,255,0) 100%);
				    letter-spacing: 1px; 
				    text-transform: uppercase;
				    text-shadow: 1px 1px 0px rgba(255,255,255,0.8);
				    margin: 0px auto; 
				    line-height: 1.4;
				'>
				    <span style='color: #8c2d19; font-size: 20px; vertical-align: middle;'>«</span> 
				    " & ZbudowanyTekst & " 
				    <span style='color: #8c2d19; font-size: 20px; vertical-align: middle;'>»</span>
				</div>"
				```
			displayFolder: Zakon Miary
			lineageTag: a1b2c3d4-0000-1111-2222-333344445552
			annotation PBI_FormatHint = {"isGeneralNumber":true}

